+/*
+ * rsos_scanout.c - RetroStoneOS: scaled scan-out for SDL's KMSDRM driver.
+ *
+ * The game renders into a fixed-size GBM surface (rsos_rw x rsos_rh, the
+ * built-in panel's size by default). The surface is shown on the CRTC's
+ * primary plane, scaled by the display engine to the active output (the
+ * panel 1:1, an HDMI monitor aspect-fit with black bars), as the libretro
+ * host does (display.c, "XR24 640x480 scaled to 1440x1080+240+0"). The game
+ * never sees a resolution change.
+ */
+#include "../../SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_KMSDRM
+
+#include "SDL_kmsdrmvideo.h"
+#include "SDL_kmsdrmdyn.h"
+
+#include <errno.h>
+#include <string.h>
+#include <sys/ioctl.h>
+
+/* 1 while the game is on an external screen (HDMI), 0 on the built-in one, -1 unknown:
+ * SDL's ALSA backend plays on the HDMI sound card or the speaker accordingly */
+volatile int rsos_audio_hdmi = -1;
+int rsos_scaled;                 /* the policy chose the output: scaled scan-out */
+int rsos_rw = 640, rsos_rh = 480; /* the size the game renders at */
+int rsos_crtc_index;
+
+static uint32_t plane_id;
+static struct { int w, h; uint32_t fb; } blacks[4];
+static int dst_x, dst_y, dst_w, dst_h;
+
+#define RSOS_UNIVERSAL_PLANES 2
+#define RSOS_PLANE_PRIMARY 1
+
+static uint32_t find_primary_plane(int fd, int crtc_index)
+{
+    drmModePlaneRes *pr;
+    uint32_t found = 0;
+    uint32_t i;
+
+    KMSDRM_drmSetClientCap(fd, RSOS_UNIVERSAL_PLANES, 1);
+    pr = KMSDRM_drmModeGetPlaneResources(fd);
+    if (!pr) {
+        return 0;
+    }
+    for (i = 0; i < pr->count_planes && !found; i++) {
+        drmModePlane *p = KMSDRM_drmModeGetPlane(fd, pr->planes[i]);
+        drmModeObjectProperties *props;
+        uint32_t j;
+
+        if (!p) {
+            continue;
+        }
+        if (p->possible_crtcs & (1u << crtc_index)) {
+            props = KMSDRM_drmModeObjectGetProperties(fd, p->plane_id, DRM_MODE_OBJECT_PLANE);
+            for (j = 0; props && j < props->count_props; j++) {
+                drmModePropertyPtr prop = KMSDRM_drmModeGetProperty(fd, props->props[j]);
+
+                if (prop) {
+                    if (SDL_strcmp(prop->name, "type") == 0 && props->prop_values[j] == RSOS_PLANE_PRIMARY) {
+                        found = p->plane_id;
+                    }
+                    KMSDRM_drmModeFreeProperty(prop);
+                }
+            }
+            if (props) {
+                KMSDRM_drmModeFreeObjectProperties(props);
+            }
+        }
+        KMSDRM_drmModeFreePlane(p);
+    }
+    KMSDRM_drmModeFreePlaneResources(pr);
+    return found;
+}
+
+/* A mode-sized black framebuffer: SetCrtc needs one at least as big as the
+ * mode, and it is what shows around the scaled picture. */
+static int make_black_fb(int fd, int w, int h, uint32_t *out)
+{
+    struct drm_mode_create_dumb c;
+    uint32_t fb = 0;
+
+    SDL_memset(&c, 0, sizeof(c));
+    c.width = (uint32_t)w;
+    c.height = (uint32_t)h;
+    c.bpp = 32;
+    if (ioctl(fd, DRM_IOCTL_MODE_CREATE_DUMB, &c) < 0) {
+        return -errno;
+    }
+    if (KMSDRM_drmModeAddFB(fd, (uint32_t)w, (uint32_t)h, 24, 32, c.pitch, c.handle, &fb) != 0) {
+        return -EINVAL;
+    }
+    *out = fb;
+    return 0;
+}
+
+/* The black framebuffer for a mode size (made once per size). */
+uint32_t rsos_black_fb(int fd, int w, int h)
+{
+    int i;
+
+    for (i = 0; i < 4; i++) {
+        if (blacks[i].fb && blacks[i].w == w && blacks[i].h == h) {
+            return blacks[i].fb;
+        }
+    }
+    for (i = 0; i < 4; i++) {
+        if (!blacks[i].fb) {
+            if (make_black_fb(fd, w, h, &blacks[i].fb) != 0) {
+                return 0;
+            }
+            blacks[i].w = w;
+            blacks[i].h = h;
+            return blacks[i].fb;
+        }
+    }
+    return 0;
+}
+
+static void fit_rect(int mw, int mh)
+{
+    if ((long)mw * rsos_rh >= (long)mh * rsos_rw) { /* height-limited */
+        dst_h = mh;
+        dst_w = (int)((long)mh * rsos_rw / rsos_rh);
+    } else {
+        dst_w = mw;
+        dst_h = (int)((long)mw * rsos_rh / rsos_rw);
+    }
+    dst_x = (mw - dst_w) / 2;
+    dst_y = (mh - dst_h) / 2;
+}
+
+/* Shows fb_id (the game's frame) on the display's CRTC. first = 1 sets the
+ * mode (the first swap, or a new output); then every frame is one plane
+ * update, which the kernel completes at the next vblank. */
+int rsos_scanout(SDL_VideoData *viddata, SDL_DisplayData *dispdata, uint32_t fb_id, int first)
+{
+    int fd = viddata->drm_fd;
+    uint32_t conn = dispdata->connector->connector_id;
+    uint32_t black;
+    int ret;
+
+    if (first) {
+        plane_id = find_primary_plane(fd, rsos_crtc_index);
+        if (!plane_id) {
+            SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "rsos: no primary plane for CRTC %d", rsos_crtc_index);
+            return -ENODEV;
+        }
+        black = rsos_black_fb(fd, dispdata->mode.hdisplay, dispdata->mode.vdisplay);
+        if (!black) {
+            return -ENOMEM;
+        }
+        ret = KMSDRM_drmModeSetCrtc(fd, dispdata->crtc->crtc_id, black, 0, 0, &conn, 1, &dispdata->mode);
+        if (ret) {
+            return ret;
+        }
+        fit_rect(dispdata->mode.hdisplay, dispdata->mode.vdisplay);
+        SDL_LogDebug(SDL_LOG_CATEGORY_VIDEO, "rsos: plane %u shows %dx%d scaled to %dx%d+%d+%d on %dx%d",
+                     plane_id, rsos_rw, rsos_rh, dst_w, dst_h, dst_x, dst_y,
+                     (int)dispdata->mode.hdisplay, (int)dispdata->mode.vdisplay);
+    }
+    return KMSDRM_drmModeSetPlane(fd, plane_id, dispdata->crtc->crtc_id, fb_id, 0,
+                                  dst_x, dst_y, (uint32_t)dst_w, (uint32_t)dst_h,
+                                  0, 0, (uint32_t)rsos_rw << 16, (uint32_t)rsos_rh << 16);
+}
