+/* ---- RetroStoneOS output policy (sdl2 patch 0001) ----------------------
+ * The game picks its output as the libretro host does (display.c): HDMI when
+ * plugged in, else the built-in panel; the policy mode; HDMI never on the
+ * panel's CRTC. The menu's environment sets the settings (RSOS_HDMI_W/H/HZ,
+ * RSOS_HDMI_CRTC, RSOS_PANEL_KEEP); defaults are the RetroStone2's. */
+static int rsos_env_int(const char *name, int def)
+{
+    const char *v = SDL_getenv(name);
+    return v && *v ? SDL_atoi(v) : def;
+}
+
+/* Does the connector have an EDID blob? (The kernel's no-EDID DMT list is
+ * not a real EDID.) */
+static SDL_bool rsos_connector_has_edid(int drm_fd, drmModeConnector *connector)
+{
+    int i;
+
+    for (i = 0; i < connector->count_props; i++) {
+        drmModePropertyPtr prop = KMSDRM_drmModeGetProperty(drm_fd, connector->props[i]);
+        SDL_bool edid = SDL_FALSE;
+
+        if (prop && SDL_strcmp(prop->name, "EDID") == 0 && connector->prop_values[i] != 0) {
+            edid = SDL_TRUE;
+        }
+        if (prop) {
+            KMSDRM_drmModeFreeProperty(prop);
+        }
+        if (edid) {
+            return SDL_TRUE;
+        }
+    }
+    return SDL_FALSE;
+}
+
+/* The connector's possible CRTCs: the union over its encoders. */
+static uint32_t rsos_possible_crtcs(int drm_fd, drmModeRes *resources, drmModeConnector *connector)
+{
+    uint32_t mask = 0;
+    int i, j;
+
+    for (i = 0; i < resources->count_encoders; i++) {
+        drmModeEncoder *enc = KMSDRM_drmModeGetEncoder(drm_fd, resources->encoders[i]);
+
+        if (!enc) {
+            continue;
+        }
+        for (j = 0; j < connector->count_encoders; j++) {
+            if (connector->encoders[j] == enc->encoder_id) {
+                mask |= enc->possible_crtcs;
+            }
+        }
+        KMSDRM_drmModeFreeEncoder(enc);
+    }
+    return mask;
+}
+
+/* Forced by the policy for the next AddDisplay() (0 = none). */
+static uint32_t rsos_force_crtc_id;
+static int rsos_force_w, rsos_force_h, rsos_force_hz;
+static uint32_t rsos_force_conn_id;
+static int rsos_choice_hdmi;
+
+/* The policy's choice among the connectors: sets rsos_force_* and returns
+ * the connector id to open first (0 = none). */
+static uint32_t rsos_policy_choose(int drm_fd, drmModeRes *resources, int probe)
+{
+    struct pf_cfg cfg;
+    struct pf_conn conns[PF_MAX_CONNS];
+    int idx[PF_MAX_CONNS];
+    struct pf_choice ch;
+    int n = 0, i;
+
+    SDL_memset(&cfg, 0, sizeof(cfg));
+    cfg.hdmi_w = rsos_env_int("RSOS_HDMI_W", 1280);
+    cfg.hdmi_h = rsos_env_int("RSOS_HDMI_H", 720);
+    cfg.hdmi_hz = rsos_env_int("RSOS_HDMI_HZ", 60);
+    cfg.hdmi_builtin_mode = SDL_TRUE;
+    cfg.hdmi_crtc_index = rsos_env_int("RSOS_HDMI_CRTC", 1);
+    cfg.panel_keep_scanning = rsos_env_int("RSOS_PANEL_KEEP", 1) != 0;
+    cfg.crtc_count = resources->count_crtcs;
+    rsos_rw = rsos_env_int("RSOS_RENDER_W", 640);
+    rsos_rh = rsos_env_int("RSOS_RENDER_H", 480);
+
+    for (i = 0; i < resources->count_connectors && n < PF_MAX_CONNS; i++) {
+        drmModeConnector *c = probe ? KMSDRM_drmModeGetConnector(drm_fd, resources->connectors[i])
+                                    : KMSDRM_drmModeGetConnectorCurrent(drm_fd, resources->connectors[i]);
+        struct pf_conn *p = &conns[n];
+        int m;
+
+        if (!c) {
+            continue;
+        }
+        SDL_memset(p, 0, sizeof(*p));
+        p->kind = (c->connector_type == DRM_MODE_CONNECTOR_HDMIA ||
+                   c->connector_type == DRM_MODE_CONNECTOR_HDMIB ||
+                   c->connector_type == DRM_MODE_CONNECTOR_DVID ||
+                   c->connector_type == DRM_MODE_CONNECTOR_DVII ||
+                   c->connector_type == DRM_MODE_CONNECTOR_DisplayPort) ? PF_KIND_HDMI : PF_KIND_LCD;
+        p->connected = c->connection == DRM_MODE_CONNECTED && c->count_modes > 0;
+        p->has_edid = rsos_connector_has_edid(drm_fd, c);
+        p->possible_crtcs = rsos_possible_crtcs(drm_fd, resources, c);
+        for (m = 0; m < c->count_modes && p->nmodes < PF_MAX_MODES; m++) {
+            p->modes[p->nmodes].w = c->modes[m].hdisplay;
+            p->modes[p->nmodes].h = c->modes[m].vdisplay;
+            p->modes[p->nmodes].hz = (int)c->modes[m].vrefresh;
+            p->modes[p->nmodes].preferred = (c->modes[m].type & DRM_MODE_TYPE_PREFERRED) != 0;
+            p->nmodes++;
+        }
+        idx[n] = i;
+        n++;
+        KMSDRM_drmModeFreeConnector(c);
+    }
+
+    ch = pf_choose(&cfg, conns, n);
+    for (i = 0; i < n; i++) {
+        SDL_LogDebug(SDL_LOG_CATEGORY_VIDEO, "rsos: conn %d kind %d connected %d edid %d modes %d possible_crtcs %x",
+                     i, (int)conns[i].kind, conns[i].connected, conns[i].has_edid, conns[i].nmodes, (unsigned)conns[i].possible_crtcs);
+    }
+    SDL_LogDebug(SDL_LOG_CATEGORY_VIDEO, "rsos: policy conn %d crtc %d mode %dx%d@%d (crtcs %d)", ch.conn, ch.crtc, ch.w, ch.h, ch.hz, cfg.crtc_count);
+    if (ch.conn < 0 || ch.crtc < 0) {
+        return 0;
+    }
+    rsos_force_crtc_id = resources->crtcs[ch.crtc];
+    rsos_crtc_index = ch.crtc;
+    rsos_scaled = 1;
+    rsos_force_w = ch.w;
+    rsos_force_h = ch.h;
+    rsos_force_hz = ch.hz;
+    rsos_force_conn_id = resources->connectors[idx[ch.conn]];
+    rsos_choice_hdmi = conns[ch.conn].kind == PF_KIND_HDMI;
+    return rsos_force_conn_id;
+}
