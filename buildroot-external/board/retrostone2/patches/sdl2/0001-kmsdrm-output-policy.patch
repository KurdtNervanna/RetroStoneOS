+/* The built-in panel's backlight (on = 0, off = 4): off behind HDMI, as the
+ * libretro host does. The panel itself keeps scanning a black frame. */
+static void rsos_backlight(SDL_bool on)
+{
+    DIR *d = opendir("/sys/class/backlight");
+    struct dirent *de;
+
+    if (!d) {
+        return;
+    }
+    while ((de = readdir(d)) != NULL) {
+        char path[256];
+        int fd;
+
+        if (de->d_name[0] == '.') {
+            continue;
+        }
+        SDL_snprintf(path, sizeof(path), "/sys/class/backlight/%s/bl_power", de->d_name);
+        fd = open(path, O_WRONLY | O_CLOEXEC);
+        if (fd >= 0) {
+            if (write(fd, on ? "0\n" : "4\n", 2) < 0) {
+                /* nothing to do */
+            }
+            close(fd);
+        }
+    }
+    closedir(d);
+}
+
+static SDL_bool rsos_is_external(uint32_t type)
+{
+    return type == DRM_MODE_CONNECTOR_HDMIA || type == DRM_MODE_CONNECTOR_HDMIB ||
+           type == DRM_MODE_CONNECTOR_DVID || type == DRM_MODE_CONNECTOR_DVII ||
+           type == DRM_MODE_CONNECTOR_DisplayPort;
+}
+
+/* Called now and then from SwapWindow: when the policy would choose another
+ * output (HDMI plugged in or unplugged), moves the game there. The game
+ * renders the same size all along, so it never notices. Returns 1 when the
+ * output changed (the caller shows the frame with rsos_scanout(first=1)). */
+int rsos_check_output(SDL_VideoData *viddata, SDL_DisplayData *dispdata)
+{
+    int fd = viddata->drm_fd;
+    drmModeRes *res = KMSDRM_drmModeGetResources(fd);
+    drmModeConnector *c;
+    drmModeCrtc *crtc;
+    uint32_t nc;
+    int i, found = -1, idx = -1;
+
+    if (!res) {
+        return 0;
+    }
+    nc = rsos_policy_choose(fd, res, 0);
+    if (!nc || nc == dispdata->connector->connector_id) {
+        KMSDRM_drmModeFreeResources(res);
+        return 0;
+    }
+    c = KMSDRM_drmModeGetConnector(fd, nc);
+    crtc = KMSDRM_drmModeGetCrtc(fd, rsos_force_crtc_id);
+    if (!c || !crtc || c->count_modes <= 0) {
+        if (c) {
+            KMSDRM_drmModeFreeConnector(c);
+        }
+        if (crtc) {
+            KMSDRM_drmModeFreeCrtc(crtc);
+        }
+        KMSDRM_drmModeFreeResources(res);
+        return 0;
+    }
+    for (i = 0; i < c->count_modes; i++) {
+        if ((int)c->modes[i].hdisplay == rsos_force_w && (int)c->modes[i].vdisplay == rsos_force_h &&
+            (int)c->modes[i].vrefresh == rsos_force_hz) {
+            found = i;
+            break;
+        }
+    }
+    for (i = 0; found < 0 && i < c->count_modes; i++) {
+        if (c->modes[i].type & DRM_MODE_TYPE_PREFERRED) {
+            found = i;
+        }
+    }
+    if (found < 0) {
+        found = 0;
+    }
+    for (i = 0; i < res->count_crtcs; i++) {
+        if (res->crtcs[i] == crtc->crtc_id) {
+            idx = i;
+        }
+    }
+
+    SDL_LogDebug(SDL_LOG_CATEGORY_VIDEO, "rsos: output change: conn %u -> %u crtc %u mode %dx%d",
+                 dispdata->connector->connector_id, nc, crtc->crtc_id,
+                 (int)c->modes[found].hdisplay, (int)c->modes[found].vdisplay);
+
+    if (rsos_is_external(dispdata->connector->connector_type)) {
+        /* leaving HDMI: its CRTC off */
+        KMSDRM_drmModeSetCrtc(fd, dispdata->crtc->crtc_id, 0, 0, 0, NULL, 0, NULL);
+    } else {
+        /* leaving the panel: it keeps scanning a black frame (never switched off) */
+        uint32_t black = rsos_black_fb(fd, dispdata->mode.hdisplay, dispdata->mode.vdisplay);
+        uint32_t oc = dispdata->connector->connector_id;
+
+        if (black) {
+            KMSDRM_drmModeSetCrtc(fd, dispdata->crtc->crtc_id, black, 0, 0, &oc, 1, &dispdata->mode);
+        }
+    }
+    rsos_backlight(rsos_is_external(c->connector_type) ? SDL_FALSE : SDL_TRUE);
+    rsos_audio_hdmi = rsos_is_external(c->connector_type) ? 1 : 0;   /* the sound follows (SDL_alsa_audio.c) */
+
+    KMSDRM_drmModeFreeConnector(dispdata->connector);
+    KMSDRM_drmModeFreeCrtc(dispdata->crtc);
+    dispdata->connector = c;
+    dispdata->crtc = crtc;
+    dispdata->mode = c->modes[found];
+    if (idx >= 0) {
+        rsos_crtc_index = idx;
+    }
+    KMSDRM_drmModeFreeResources(res);
+    return 1;
+}
