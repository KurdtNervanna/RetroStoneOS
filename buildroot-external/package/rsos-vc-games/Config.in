config BR2_PACKAGE_RSOS_VC_GAMES
	bool "rsos-vc-games"
	depends on !BR2_STATIC_LIBS # libretro cores, loaded with dlopen()
	help
	  The RetroStone VC games (8BCraft), the "RetroStone"
	  system at the start of the menu's carousel (docs/vc-games.md).

	  Each game is a libretro core built from the RetroStone VC
	  source (https://github.com/PaddleStroke/RetroStoneVC): the
	  SDK, the tools and the game code are MIT; the games' art,
	  music, sound, levels and design are CC BY-NC-SA 4.0. The game
	  is inside the core, there is no ROM.
	  Installs:
	  - /usr/lib/libretro/<game>_libretro.so and
	    /usr/share/rsos/cores/<game>.ini (no_content = true);
	  - /usr/share/rsos/games/retrostone/: one menu entry per game
	    ("Bomber Mole.bombermole", a stub file the host never
	    reads), gamelist.xml and media/images/ (title screens);
	  - /usr/share/rsos/licenses/retrostone-vc/.

	  "make legal-info" saves the source (the synced checkout).
	  The build needs python3 with Pillow and NumPy on the build host
	  (python3-pil, python3-numpy) for the games' asset step.

# Defined even when the package is disabled: the .mk sets the local SITE from
# it at parse time, and Buildroot parses every package .mk.
config BR2_PACKAGE_RSOS_VC_GAMES_SOURCE_DIR
	string "RetroStone VC checkout"
	default "$(BR2_EXTERNAL_RETROSTONE_PATH)/../../RetroStoneVC"
	help
	  The RetroStone VC repository (sdk/, games/, Makefile): by
	  default a checkout next to the RetroStoneOS one. CI checks
	  out the public PaddleStroke/RetroStoneVC and sets this path
	  (scripts/ci/build-board.sh, docs/ci.md). The build copies it
	  without build/, dist/, the art inbox and .git.

if BR2_PACKAGE_RSOS_VC_GAMES

config BR2_PACKAGE_RSOS_VC_GAMES_BOMBERMOLE
	bool "Bomber Mole"
	default y
	help
	  A mole who drops bombs to open the way, on three depths at
	  once, through four seasons. 1 player.

config BR2_PACKAGE_RSOS_VC_GAMES_LEADYSQUID
	bool "Leady Squid"
	default y
	help
	  A one-button "flap" game: a squid with too many lead weights
	  swims through the gaps of a sunken world. 1-4 players.

config BR2_PACKAGE_RSOS_VC_GAMES_DUCKPARADE
	bool "Duck Parade"
	default y
	help
	  Guide a family of ducks through ponds, roads and rivers. Up to
	  four parents cooperate to bring the ducklings home.

config BR2_PACKAGE_RSOS_VC_GAMES_BLUEBERRYTUMBLE
	bool "Blueberry Tumble"
	default y
	help
	  Roll a blueberry down a changing mountain landscape. Dodge
	  obstacles, collect dew and race with up to four players.

config BR2_PACKAGE_RSOS_VC_GAMES_BEAVERRUSH
	bool "Beaver Rush"
	default y
	help
	  Chop trees, dodge hazards and build your score. A fast arcade
	  challenge for one player or a race for up to four.

config BR2_PACKAGE_RSOS_VC_GAMES_PANCAKETOWER
	bool "Pancake Tower"
	default y
	help
	  Stack falling pancakes as precisely as possible, from the
	  kitchen to outer space. Build the tallest tower in solo play
	  or compete with up to four chefs.

config BR2_PACKAGE_RSOS_VC_GAMES_POGOMAMIE
	bool "Pogo Mamie"
	default y
	help
	  Bounce across the rooftops of Paris on a pogo stick. Avoid
	  aerial hazards, stomp pigeons and race with up to four
	  grannies.

config BR2_PACKAGE_RSOS_VC_GAMES_BISCUITBANDIT
	bool "Biscuit Bandit"
	default y
	help
	  A raccoon raids a bakery: catch the cookies falling from the
	  belts on your tray, but never the cups, and carry the stack to
	  the basket. 1-4 players.

config BR2_PACKAGE_RSOS_VC_GAMES_CRABCOCONUT
	bool "Crab Coconut"
	default y
	help
	  A crab on the beach bounces a coconut off its claws to break
	  the shells that rain from the sky. 1-4 players.

config BR2_PACKAGE_RSOS_VC_GAMES_FROGREACH
	bool "Frog Reach"
	default y
	help
	  Hold to stretch the frog's tongue just far enough to catch the
	  flies and cross the swamp from lily pad to lily pad. 1-4
	  players.

config BR2_PACKAGE_RSOS_VC_GAMES_HEDGEHOGHILLS
	bool "Hedgehog Hills"
	default y
	help
	  Curl up downhill, let go uphill: a hedgehog rolls and flies
	  over endless woodland hills. 1-4 players.

config BR2_PACKAGE_RSOS_VC_GAMES_MOLEMARBLES
	bool "Mole Marbles"
	default y
	help
	  A miner mole splits the bouncing gemstones of a cave with its
	  harpoon before they crush it. 1-4 players.

config BR2_PACKAGE_RSOS_VC_GAMES_MOTHAROUND
	bool "Moth Around"
	default y
	help
	  A moth circles a lantern at night: turn one way or the other
	  to slip through the closing rings. 1-4 players.

config BR2_PACKAGE_RSOS_VC_GAMES_MOUSEESPRESSO
	bool "Mouse Espresso"
	default y
	help
	  A mouse wearing an espresso machine flies through the cafe on
	  bursts of steam, collecting biscuits. 1-4 players.

config BR2_PACKAGE_RSOS_VC_GAMES_NUTTYBRANCH
	bool "Nutty Branch"
	default y
	help
	  A squirrel runs along an endless branch: steer, jump the gaps
	  and dodge the traps without sliding off its sides. 1-4
	  players.

config BR2_PACKAGE_RSOS_VC_GAMES_OTTERRAPIDS
	bool "Otter Rapids"
	default y
	help
	  An otter paddles down the river, catching golden fish and
	  dodging rocks, logs and the shadow of a hungry pike. 1-4
	  players.

config BR2_PACKAGE_RSOS_VC_GAMES_PENGUINSLALOM
	bool "Penguin Slalom"
	default y
	help
	  A penguin skis between the flags down an endless snowy slope,
	  catching fish and dodging polar bears. 1-4 players.

config BR2_PACKAGE_RSOS_VC_GAMES_RADISHRASCALS
	bool "Radish Rascals"
	default y
	help
	  A farmer shoos the rabbits from the vegetable beds with a
	  pitchfork, but must spare the hedgehogs. 1-4 players.

config BR2_PACKAGE_RSOS_VC_GAMES_RACCOONRECYCLER
	bool "Raccoon Recycler"
	default y
	help
	  A raccoon sorts the toys sliding down the chutes by kind or by
	  colour, while the rules keep changing. 1-4 players.

config BR2_PACKAGE_RSOS_VC_GAMES_SNAILSWITCH
	bool "Snail Switch"
	default y
	help
	  A snail flips above or below the vine to dodge thorns and
	  caterpillars and reach the fruits. 1-4 players.

config BR2_PACKAGE_RSOS_VC_GAMES_SPIDERSWING
	bool "Spider Swing"
	default y
	help
	  A spider swings from flower to flower on its silk and climbs
	  ever higher. 1-4 players.

config BR2_PACKAGE_RSOS_VC_GAMES_UNICORNHOP
	bool "Unicorn Hop"
	default y
	help
	  A unicorn hops from cloud to cloud, straight up through a sky
	  of drifting clouds, from morning to the aurora. 1-4 players.

endif

comment "rsos-vc-games needs a toolchain w/ dynamic library"
	depends on BR2_STATIC_LIBS
