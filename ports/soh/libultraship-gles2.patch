+// a texture was bound outside SelectTexture(): its cache no longer says what is bound
+#define FORGET_TEXTURE_BINDINGS() do { mLastActiveTexture = -1; for (GLuint& bound : mLastBoundTextures) bound = (GLuint)-1; } while (0)
+
+#include <cstring>
+
+#ifdef USE_GLES2
+/*
+ * OpenGL ES 2.0: no sized texture formats, no multisampling, no blits and no
+ * depth reads. Multisampling stays off (mMaxMsaaLevel 1), so the multisample
+ * calls below are never reached; CopyFramebuffer and GetPixelDepth have their
+ * own GLES2 versions. Depth: packed depth+stencil when the driver has
+ * GL_OES_packed_depth_stencil, else a 16-bit depth buffer.
+ */
+#define GL_RGB8 GL_RGB
+#define GL_RGBA8 GL_RGBA
+#define GL_DEPTH24_STENCIL8 GL_DEPTH24_STENCIL8_OES
+#define GL_DEPTH_STENCIL GL_DEPTH_STENCIL_OES
+#define GL_UNSIGNED_INT_24_8 GL_UNSIGNED_INT_24_8_OES
+#define GL_READ_FRAMEBUFFER GL_FRAMEBUFFER
+#define GL_DRAW_FRAMEBUFFER GL_FRAMEBUFFER
+#define glBlitFramebuffer(...) ((void)0)
+#define glReadBuffer(b) ((void)0)
+#define glRenderbufferStorageMultisample(target, samples, format, w, h) glRenderbufferStorage(target, format, w, h)
+static bool sPackedDepthStencil = true;
+#endif
+
+namespace Fast {
+static void RenderbufferDepthStorage(GLsizei width, GLsizei height) {
+#ifdef USE_GLES2
+    glRenderbufferStorage(GL_RENDERBUFFER, sPackedDepthStencil ? GL_DEPTH24_STENCIL8_OES : GL_DEPTH_COMPONENT16,
+                          width, height);
+#else
+    glRenderbufferStorage(GL_RENDERBUFFER, GL_DEPTH24_STENCIL8, width, height);
+#endif
+}
+
+static void FramebufferDepthAttach(GLuint rb) {
+#ifdef USE_GLES2
+    glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, rb);
+    glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_STENCIL_ATTACHMENT, GL_RENDERBUFFER, sPackedDepthStencil ? rb : 0);
+#else
+    glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT, GL_RENDERBUFFER, rb);
+#endif
+}
